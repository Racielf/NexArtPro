{
  "name": "BankTransaction",
  "type": "object",
  "properties": {
    "bank_account_id": {
      "type": "string"
    },
    "bank_account_name": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "description": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "type": {
      "type": "string",
      "enum": [
        "income",
        "expense"
      ],
      "default": "expense"
    },
    "category": {
      "type": "string",
      "enum": [
        "materials",
        "payroll",
        "fuel",
        "subcontractors",
        "office_admin",
        "miscellaneous",
        "service_income",
        "deposit",
        "other"
      ],
      "default": "miscellaneous"
    },
    "related_work_order_id": {
      "type": "string"
    },
    "related_work_order_number": {
      "type": "number"
    },
    "related_customer_id": {
      "type": "string"
    },
    "related_customer_name": {
      "type": "string"
    },
    "related_expense_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "is_reviewed": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "bank_account_id",
    "date",
    "description",
    "amount",
    "type"
  ]
}