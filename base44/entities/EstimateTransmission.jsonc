{
  "name": "EstimateTransmission",
  "type": "object",
  "properties": {
    "estimate_id": {
      "type": "string",
      "description": "Reference to sent Estimate"
    },
    "snapshot_id": {
      "type": "string",
      "description": "Reference to EstimateSnapshot created at send time (nullable if send failed before snapshot)"
    },
    "recipient_email": {
      "type": "string",
      "description": "Email address message was sent to"
    },
    "provider": {
      "type": "string",
      "enum": [
        "resend",
        "manual"
      ],
      "default": "resend",
      "description": "Email service provider"
    },
    "provider_message_id": {
      "type": "string",
      "description": "Message ID from email service (e.g. Resend message_id)"
    },
    "status": {
      "type": "string",
      "enum": [
        "sent",
        "failed"
      ],
      "default": "sent",
      "description": "Transmission status: sent = successful delivery to provider, failed = error before/during send"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when email was sent to provider (null if failed before send)"
    },
    "failed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when send failed (null if successful)"
    },
    "error_message": {
      "type": "string",
      "description": "Error details if send failed"
    },
    "subject": {
      "type": "string",
      "description": "Email subject line sent"
    },
    "client_name": {
      "type": "string",
      "description": "Client name snapshot at send time"
    },
    "estimate_number": {
      "type": "number",
      "description": "Estimate number snapshot at send time"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "BID",
        "PROPOSAL",
        "ESTIMATE"
      ],
      "description": "Document type sent"
    },
    "company_id": {
      "type": "string",
      "description": "Company identifier for multi-tenant support",
      "default": "rc-art"
    }
  },
  "required": [
    "estimate_id",
    "recipient_email",
    "status"
  ]
}