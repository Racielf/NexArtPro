{
  "name": "Estimate",
  "type": "object",
  "properties": {
    "estimate_number": {
      "type": "number"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "BID",
        "PROPOSAL"
      ],
      "default": "PROPOSAL",
      "description": "Document type: BID (technical/commercial) or PROPOSAL (client-friendly)"
    },
    "document_language": {
      "type": "string",
      "enum": [
        "en",
        "es",
        "bilingual"
      ],
      "default": "en",
      "description": "Document language: en (English), es (Spanish), bilingual (both)"
    },
    "job_number": {
      "type": "string",
      "description": "Job or project number reference (required for BID type)"
    },
    "plan_reference": {
      "type": "string",
      "description": "Plan set or specification reference (required for BID type if no job_number)"
    },
    "source_proposal_id": {
      "type": "string",
      "description": "Reference to source Proposal if created as adjustment"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "client_phone": {
      "type": "string"
    },
    "client_address": {
      "type": "string"
    },
    "appointment_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "on_my_way",
        "visit_completed",
        "sent",
        "viewed",
        "changes_requested",
        "approved",
        "signed",
        "declined",
        "converted"
      ],
      "default": "draft"
    },
    "expiration_date": {
      "type": "string",
      "format": "date"
    },
    "project_start_date": {
      "type": "string",
      "format": "date"
    },
    "project_end_date": {
      "type": "string",
      "format": "date"
    },
    "assigned_to": {
      "type": "string"
    },
    "created_by": {
      "type": "string",
      "description": "Email or name of user who created the estimate"
    },
    "updated_by": {
      "type": "string",
      "description": "Email or name of user who last updated the estimate"
    },
    "groups": {
      "type": "array",
      "description": "Work groups, each containing line items",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "collapsed": {
            "type": "boolean"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "service_name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "quantity": {
                  "type": "number"
                },
                "unit": {
                  "type": "string"
                },
                "unit_price": {
                  "type": "number"
                },
                "unit_cost": {
                  "type": "number"
                },
                "line_total": {
                  "type": "number"
                },
                "taxable": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "line_items": {
      "type": "array",
      "description": "Legacy flat line items (kept for backward compat)",
      "items": {
        "type": "object"
      }
    },
    "subtotal": {
      "type": "number"
    },
    "discount_type": {
      "type": "string",
      "enum": [
        "percent",
        "fixed"
      ],
      "default": "percent"
    },
    "discount_value": {
      "type": "number",
      "default": 0
    },
    "discount_amount": {
      "type": "number",
      "default": 0
    },
    "deposit_percent": {
      "type": "number",
      "default": 0
    },
    "deposit_amount": {
      "type": "number",
      "default": 0
    },
    "tax_rate": {
      "type": "number",
      "default": 0
    },
    "tax_amount": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "total_cost": {
      "type": "number"
    },
    "gross_margin": {
      "type": "number"
    },
    "gross_margin_pct": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "internal_notes": {
      "type": "string"
    },
    "exclusions": {
      "type": "string"
    },
    "warranty_terms": {
      "type": "string"
    },
    "payment_terms": {
      "type": "string"
    },
    "legal_terms": {
      "type": "string"
    },
    "sent_at": {
      "type": "string"
    },
    "viewed_at": {
      "type": "string"
    },
    "approved_at": {
      "type": "string"
    },
    "approved_by": {
      "type": "string",
      "description": "Email or name of admin who approved manually"
    },
    "approval_note": {
      "type": "string",
      "description": "Internal note when manually approved"
    },
    "declined_reason": {
      "type": "string"
    },
    "changes_requested_at": {
      "type": "string"
    },
    "changes_requested_note": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "signer_name": {
      "type": "string"
    },
    "signer_email": {
      "type": "string"
    },
    "signer_ip": {
      "type": "string"
    },
    "signed_at": {
      "type": "string"
    },
    "signature_image_base64": {
      "type": "string"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date"
    },
    "scheduled_time": {
      "type": "string"
    },
    "omw_start_time": {
      "type": "string"
    },
    "completed_time": {
      "type": "string"
    },
    "miles_traveled": {
      "type": "number",
      "default": 0
    },
    "document_config": {
      "type": "object",
      "description": "Document rendering configuration (template + options)",
      "properties": {
        "template": {
          "type": "string",
          "description": "Template key: minimal, compact, professional, modern, executive, detailed",
          "default": "professional"
        },
        "options": {
          "type": "object",
          "description": "Document visibility options",
          "properties": {
            "showPrices": {
              "type": "boolean",
              "default": true
            },
            "showBreakdown": {
              "type": "boolean",
              "default": true
            },
            "showTerms": {
              "type": "boolean",
              "default": true
            },
            "showSignatures": {
              "type": "boolean",
              "default": true
            },
            "hideInternalNotes": {
              "type": "boolean",
              "default": true,
              "description": "CRITICAL: Always true to prevent internal notes from showing to client"
            }
          }
        }
      }
    },
    "company_id": {
      "type": "string",
      "description": "Company identifier for multi-tenant support",
      "default": "rc-art"
    }
  },
  "required": [
    "client_name"
  ]
}