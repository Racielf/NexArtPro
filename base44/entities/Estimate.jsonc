{
  "name": "Estimate",
  "type": "object",
  "properties": {
    "estimate_number": { "type": "number" },
    "document_type": {
      "type": "string",
      "enum": ["ESTIMATE", "BID", "PROPOSAL"],
      "default": "ESTIMATE",
      "description": "Document type aligned with editor behavior"
    },
    "document_language": {
      "type": "string",
      "enum": ["en", "es", "bilingual"],
      "default": "en"
    },
    "version_number": { "type": "number", "default": 1 },
    "parent_estimate_id": { "type": "string" },
    "job_number": { "type": "string" },
    "plan_reference": { "type": "string" },
    "client_id": { "type": "string" },
    "client_name": { "type": "string" },
    "client_email": { "type": "string" },
    "client_phone": { "type": "string" },
    "client_address": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["draft", "sent", "viewed", "approved", "declined"],
      "default": "draft"
    },
    "groups": { "type": "array", "items": { "type": "object" } },
    "materials": { "type": "array", "items": { "type": "object" } },
    "line_items": { "type": "array", "items": { "type": "object" } },
    "attachments": { "type": "array", "items": { "type": "object" } },
    "subtotal": { "type": "number" },
    "tax_rate": { "type": "number", "default": 0 },
    "total": { "type": "number" },
    "notes": { "type": "string" },
    "internal_notes": { "type": "string" },
    "document_config": { "type": "object" },
    "deleted_at": { "type": "string", "format": "date-time" },
    "deleted_by": { "type": "string" },
    "delete_reason": { "type": "string" },
    "restored_at": { "type": "string", "format": "date-time" },
    "restored_by": { "type": "string" }
  },
  "required": ["client_name"]
}