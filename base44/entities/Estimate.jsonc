{
  "name": "Estimate",
  "type": "object",
  "properties": {
    "estimate_number": { "type": "number" },
    "document_type": {
      "type": "string",
      "enum": ["ESTIMATE", "BID", "PROPOSAL"],
      "default": "ESTIMATE",
      "description": "Document type aligned with editor behavior"
    },
    "document_language": {
      "type": "string",
      "enum": ["en", "es", "bilingual"],
      "default": "en"
    },
    "version_number": { "type": "number", "default": 1 },
    "parent_estimate_id": { "type": "string" },
    "job_number": { "type": "string" },
    "plan_reference": { "type": "string" },
    "client_id": { "type": "string" },
    "client_name": { "type": "string" },
    "client_email": { "type": "string" },
    "client_phone": { "type": "string" },
    "client_address": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "project_start_date": { "type": "string" },
    "project_end_date": { "type": "string" },
    "expiration_date": { "type": "string" },
    "assigned_to": { "type": "string" },
    "appointment_id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["draft", "scheduled", "on_my_way", "visit_completed", "sent", "viewed", "changes_requested", "approved", "signed", "declined", "converted"],
      "default": "draft"
    },
    "sales_stage": { "type": "string" },
    "groups": { "type": "array", "items": { "type": "object" } },
    "materials": { "type": "array", "items": { "type": "object" } },
    "other_costs": { "type": "array", "items": { "type": "object" } },
    "line_items": { "type": "array", "items": { "type": "object" } },
    "attachments": { "type": "array", "items": { "type": "object" } },
    "services_subtotal": { "type": "number", "default": 0 },
    "materials_subtotal": { "type": "number", "default": 0 },
    "subtotal": { "type": "number", "default": 0 },
    "tax_rate": { "type": "number", "default": 0 },
    "tax_amount": { "type": "number", "default": 0 },
    "discount_type": { "type": "string", "enum": ["percent", "fixed"], "default": "percent" },
    "discount_value": { "type": "number", "default": 0 },
    "discount_amount": { "type": "number", "default": 0 },
    "total": { "type": "number", "default": 0 },
    "deposit_percent": { "type": "number", "default": 0 },
    "deposit_amount": { "type": "number", "default": 0 },
    "service_cost": { "type": "number", "default": 0 },
    "materials_cost": { "type": "number", "default": 0 },
    "other_costs_total": { "type": "number", "default": 0 },
    "total_cost": { "type": "number", "default": 0 },
    "total_book_value": { "type": "number", "default": 0 },
    "total_variance": { "type": "number", "default": 0 },
    "margin_percentage": { "type": "number", "default": 0 },
    "gross_margin": { "type": "number", "default": 0 },
    "gross_margin_pct": { "type": "number", "default": 0 },
    "net_profit": { "type": "number", "default": 0 },
    "net_profit_pct": { "type": "number", "default": 0 },
    "notes": { "type": "string" },
    "internal_notes": { "type": "string" },
    "exclusions": { "type": "string" },
    "payment_terms": { "type": "string" },
    "warranty_terms": { "type": "string" },
    "legal_terms": { "type": "string" },
    "scope_summary": { "type": "string" },
    "assumptions": { "type": "string" },
    "change_request_policy": { "type": "string" },
    "included_scope_bullets": { "type": "string" },
    "uncertainty_note": { "type": "string" },
    "contingency_type": { "type": "string", "enum": ["none", "percent", "fixed"], "default": "none" },
    "contingency_value": { "type": "number", "default": 0 },
    "contingency_amount": { "type": "number", "default": 0 },
    "show_contingency_to_client": { "type": "boolean", "default": false },
    "document_config": { "type": "object" },
    "public_share_token": { "type": "string" },
    "public_share_token_created_at": { "type": "string", "format": "date-time" },
    "sent_at": { "type": "string", "format": "date-time" },
    "viewed_at": { "type": "string", "format": "date-time" },
    "approved_at": { "type": "string", "format": "date-time" },
    "signed_at": { "type": "string", "format": "date-time" },
    "accepted_by": { "type": "string" },
    "signature_name": { "type": "string" },
    "signature_image": { "type": "string" },
    "signature_method": { "type": "string" },
    "signing_package_id": { "type": "string" },
    "signature_status": {
      "type": "string",
      "enum": ["not_sent", "sent", "viewed", "signed", "declined", "expired", "voided"],
      "default": "not_sent"
    },
    "terms_accepted": { "type": "boolean", "default": false },
    "legal_audit": { "type": "object" },
    "signature_certificate": { "type": "object" },
    "document_hash": { "type": "string" },
    "document_hash_algorithm": { "type": "string", "default": "SHA-256" },
    "certificate_generated_at": { "type": "string", "format": "date-time" },
    "signed_pdf_hash": { "type": "string" },
    "signed_pdf_hash_algorithm": { "type": "string", "default": "SHA-256" },
    "signature_provider": {
      "type": "string",
      "enum": ["internal", "docusign", "dropbox_sign", "pandadoc", "adobe_sign", "signnow", "other"],
      "default": "internal",
      "description": "Provider used for signature workflow. Internal remains default."
    },
    "external_signature_request_id": { "type": "string" },
    "external_signature_status": { "type": "string" },
    "external_signature_url": { "type": "string" },
    "external_signature_provider_payload": { "type": "object" },
    "external_signature_completed_at": { "type": "string", "format": "date-time" },
    "external_signature_certificate_url": { "type": "string" },
    "external_signature_signed_pdf_url": { "type": "string" },
    "locked_after_signature": { "type": "boolean", "default": false },
    "final_signed_at": { "type": "string", "format": "date-time" },
    "final_signed_pdf_name": { "type": "string" },
    "legal_package_locked": { "type": "boolean", "default": false },
    "declined_at": { "type": "string", "format": "date-time" },
    "declined_reason": { "type": "string" },
    "converted_to_work_order_at": { "type": "string", "format": "date-time" },
    "converted_work_order_id": { "type": "string" },
    "converted_invoice_id": { "type": "string" },
    "final_signed_pdf_url": { "type": "string" },
    "updated_by": { "type": "string" },
    "deleted_at": { "type": "string", "format": "date-time" },
    "deleted_by": { "type": "string" },
    "delete_reason": { "type": "string" },
    "restored_at": { "type": "string", "format": "date-time" },
    "restored_by": { "type": "string" }
  },
  "required": ["client_name"]
}