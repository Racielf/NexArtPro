{
  "name": "Estimate",
  "type": "object",
  "properties": {
    "estimate_number": {
      "type": "number"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "BID",
        "PROPOSAL"
      ],
      "default": "PROPOSAL",
      "description": "Document type: BID (technical/commercial) or PROPOSAL (client-friendly)"
    },
    "document_language": {
      "type": "string",
      "enum": [
        "en",
        "es",
        "bilingual"
      ],
      "default": "en",
      "description": "Document language: en (English), es (Spanish), bilingual (both)"
    },
    "job_number": {
      "type": "string",
      "description": "Job or project number reference (required for BID type)"
    },
    "plan_reference": {
      "type": "string",
      "description": "Plan set or specification reference (required for BID type if no job_number)"
    },
    "source_proposal_id": {
      "type": "string",
      "description": "Reference to source Proposal if created as adjustment"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "client_phone": {
      "type": "string"
    },
    "client_address": {
      "type": "string"
    },
    "appointment_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "on_my_way",
        "visit_completed",
        "sent",
        "viewed",
        "changes_requested",
        "approved",
        "signed",
        "declined",
        "converted"
      ],
      "default": "draft"
    },
    "sales_stage": {
      "type": "string",
      "enum": [
        "lead",
        "presented",
        "engaged",
        "negotiation",
        "won",
        "lost",
        "converted"
      ],
      "default": "lead",
      "description": "Sales pipeline stage derived from status transitions"
    },
    "view_count": {
      "type": "number",
      "default": 0,
      "description": "Number of times client has viewed this estimate"
    },
    "last_viewed_at": {
      "type": "string",
      "description": "Timestamp of the most recent client view"
    },
    "last_client_event": {
      "type": "string",
      "description": "Last client action: viewed, approved, signed, declined, changes_requested"
    },
    "next_follow_up_at": {
      "type": "string",
      "description": "Suggested next follow-up datetime"
    },
    "follow_up_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "action_required",
        "completed"
      ],
      "default": "none",
      "description": "Current follow-up state"
    },
    "follow_up_stage": {
      "type": "string",
      "enum": [
        "none",
        "initial",
        "post_view",
        "revision",
        "won",
        "lost"
      ],
      "default": "none",
      "description": "Follow-up pipeline position"
    },
    "expiration_date": {
      "type": "string",
      "format": "date"
    },
    "project_start_date": {
      "type": "string",
      "format": "date"
    },
    "project_end_date": {
      "type": "string",
      "format": "date"
    },
    "assigned_to": {
      "type": "string"
    },
    "created_by": {
      "type": "string",
      "description": "Email or name of user who created the estimate"
    },
    "updated_by": {
      "type": "string",
      "description": "Email or name of user who last updated the estimate"
    },
    "groups": {
      "type": "array",
      "description": "Work groups, each containing line items",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "collapsed": {
            "type": "boolean"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "service_name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "quantity": {
                  "type": "number"
                },
                "unit": {
                  "type": "string"
                },
                "unit_price": {
                  "type": "number"
                },
                "unit_cost": {
                  "type": "number"
                },
                "line_total": {
                  "type": "number"
                },
                "taxable": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "materials": {
      "type": "array",
      "description": "Optional structured materials items",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "unit_price": {
            "type": "number"
          },
          "unit_cost": {
            "type": "number"
          },
          "line_total": {
            "type": "number"
          }
        }
      }
    },
    "other_costs": {
      "type": "array",
      "description": "Job-level internal costs not in line items",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "other_costs_total": {
      "type": "number",
      "default": 0,
      "description": "Sum of other_costs amounts (internal)"
    },
    "net_profit": {
      "type": "number",
      "default": 0,
      "description": "gross_margin - other_costs_total (internal)"
    },
    "net_profit_pct": {
      "type": "number",
      "default": 0,
      "description": "net_profit / total * 100 (internal)"
    },
    "line_items": {
      "type": "array",
      "description": "Legacy flat line items (kept for backward compat)",
      "items": {
        "type": "object"
      }
    },
    "attachments": {
      "type": "array",
      "description": "File attachments with intent: internal_only or send_to_client",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "file_url": {
            "type": "string",
            "description": "Public URL of uploaded file"
          },
          "file_name": {
            "type": "string"
          },
          "intent": {
            "type": "string",
            "enum": [
              "internal_only",
              "send_to_client"
            ],
            "default": "internal_only"
          },
          "uploaded_by": {
            "type": "string"
          },
          "uploaded_at": {
            "type": "string"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "discount_type": {
      "type": "string",
      "enum": [
        "percent",
        "fixed"
      ],
      "default": "percent"
    },
    "discount_value": {
      "type": "number",
      "default": 0
    },
    "discount_amount": {
      "type": "number",
      "default": 0
    },
    "deposit_percent": {
      "type": "number",
      "default": 0
    },
    "deposit_amount": {
      "type": "number",
      "default": 0
    },
    "tax_rate": {
      "type": "number",
      "default": 0
    },
    "tax_amount": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "total_cost": {
      "type": "number"
    },
    "gross_margin": {
      "type": "number"
    },
    "gross_margin_pct": {
      "type": "number"
    },
    "materials_subtotal": {
      "type": "number",
      "default": 0,
      "description": "Sum of materials line totals"
    },
    "notes": {
      "type": "string"
    },
    "internal_notes": {
      "type": "string"
    },
    "exclusions": {
      "type": "string"
    },
    "warranty_terms": {
      "type": "string"
    },
    "payment_terms": {
      "type": "string"
    },
    "legal_terms": {
      "type": "string"
    },
    "scope_summary": {
      "type": "string",
      "description": "Client-visible summary of the overall scope of work"
    },
    "assumptions": {
      "type": "string",
      "description": "Project assumptions and conditions agreed upon by both parties"
    },
    "change_request_policy": {
      "type": "string",
      "description": "Policy for handling changes after estimate is approved"
    },
    "included_scope_bullets": {
      "type": "string",
      "description": "Newline-separated list of what is included in this estimate \u2014 each line renders as one bullet in the document"
    },
    "sent_at": {
      "type": "string"
    },
    "viewed_at": {
      "type": "string"
    },
    "approved_at": {
      "type": "string"
    },
    "approved_by": {
      "type": "string",
      "description": "Email or name of admin who approved manually"
    },
    "approval_note": {
      "type": "string",
      "description": "Internal note when manually approved"
    },
    "declined_at": {
      "type": "string",
      "description": "Timestamp when estimate was declined"
    },
    "declined_reason": {
      "type": "string"
    },
    "changes_requested_at": {
      "type": "string"
    },
    "changes_requested_note": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "signer_name": {
      "type": "string"
    },
    "signer_email": {
      "type": "string"
    },
    "signer_ip": {
      "type": "string"
    },
    "signed_at": {
      "type": "string"
    },
    "signature_image_base64": {
      "type": "string"
    },
    "signature_on_file": {
      "type": "boolean",
      "default": false,
      "description": "Whether a signature was captured at acceptance"
    },
    "acceptance_proof": {
      "type": "object",
      "description": "Immutable acceptance proof snapshot \u2014 client-safe commercial/legal record of acceptance event"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date"
    },
    "scheduled_time": {
      "type": "string"
    },
    "omw_start_time": {
      "type": "string"
    },
    "completed_time": {
      "type": "string"
    },
    "miles_traveled": {
      "type": "number",
      "default": 0
    },
    "document_config": {
      "type": "object",
      "description": "Document rendering configuration (template + options)",
      "properties": {
        "template": {
          "type": "string",
          "description": "Template key",
          "default": "professional"
        },
        "options": {
          "type": "object",
          "description": "Document visibility options",
          "properties": {
            "showPrices": {
              "type": "boolean",
              "default": true
            },
            "showBreakdown": {
              "type": "boolean",
              "default": true
            },
            "showTerms": {
              "type": "boolean",
              "default": true
            },
            "showSignatures": {
              "type": "boolean",
              "default": true
            },
            "hideInternalNotes": {
              "type": "boolean",
              "default": true,
              "description": "CRITICAL: Always true to prevent internal notes from showing to client"
            },
            "showMaterials": {
              "type": "boolean",
              "default": true
            }
          }
        }
      }
    },
    "company_id": {
      "type": "string",
      "description": "Company identifier for multi-tenant support",
      "default": "rc-art"
    }
  },
  "required": [
    "client_name"
  ]
}