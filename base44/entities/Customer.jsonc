{
  "name": "Customer",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "customer_type": {
      "type": "string",
      "enum": [
        "residential",
        "commercial",
        "contractor"
      ],
      "default": "residential"
    },
    "company_name": {
      "type": "string"
    },
    "service_address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "internal_notes": {
      "type": "string"
    },
    "preferred_language": {
      "type": "string",
      "enum": [
        "en",
        "es",
        "bilingual"
      ],
      "default": "en",
      "description": "Customer preferred document language"
    },
    "company_id": {
      "type": "string",
      "description": "Company identifier for multi-tenant support",
      "default": "rc-art"
    }
  },
  "required": [
    "first_name",
    "last_name",
    "phone"
  ]
}