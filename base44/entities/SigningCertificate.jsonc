{
  "name": "SigningCertificate",
  "type": "object",
  "properties": {
    "signing_package_id": {
      "type": "string"
    },
    "certificate_number": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "default": "issued"
    },
    "document_type": {
      "type": "string"
    },
    "document_id": {
      "type": "string"
    },
    "document_hash": {
      "type": "string"
    },
    "final_pdf_url": {
      "type": "string"
    },
    "final_pdf_hash": {
      "type": "string"
    },
    "signed_at": {
      "type": "string",
      "format": "date-time"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "signer_name": {
      "type": "string"
    },
    "signer_email": {
      "type": "string"
    },
    "company_id": {
      "type": "string",
      "default": "rc-art"
    },
    "audit_trail": {
      "type": "object"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "signing_package_id"
  ]
}