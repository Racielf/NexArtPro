{
  "name": "SigningOtpChallenge",
  "type": "object",
  "properties": {
    "signing_package_id": { "type": "string" },
    "token_hash": { "type": "string" },
    "signer_email": { "type": "string" },
    "otp_hash": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["pending", "verified", "expired", "failed", "used"],
      "default": "pending"
    },
    "attempts": { "type": "number", "default": 0 },
    "max_attempts": { "type": "number", "default": 5 },
    "expires_at": { "type": "string", "format": "date-time" },
    "verified_at": { "type": "string", "format": "date-time" },
    "used_at": { "type": "string", "format": "date-time" },
    "ip_address": { "type": "string" },
    "user_agent": { "type": "string" },
    "fingerprint": { "type": "string" },
    "delivery_channel": {
      "type": "string",
      "enum": ["email", "sms", "manual", "test"],
      "default": "email"
    },
    "delivery_status": {
      "type": "string",
      "enum": ["pending", "sent", "failed", "not_configured"],
      "default": "pending"
    },
    "metadata": { "type": "object" },
    "created_at": { "type": "string", "format": "date-time" },
    "company_id": { "type": "string", "default": "rc-art" }
  },
  "required": ["signing_package_id", "token_hash", "signer_email", "otp_hash", "expires_at"]
}
