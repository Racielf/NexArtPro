{
  "name": "ProjectPhoto",
  "type": "object",
  "properties": {
    "photo_url": {
      "type": "string",
      "description": "URL of the uploaded photo"
    },
    "phase": {
      "type": "string",
      "enum": [
        "before",
        "during",
        "after"
      ],
      "default": "before",
      "description": "Phase of the project when photo was taken"
    },
    "caption": {
      "type": "string"
    },
    "work_order_id": {
      "type": "string"
    },
    "appointment_id": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "work_order_number": {
      "type": "number"
    },
    "taken_by": {
      "type": "string"
    }
  },
  "required": [
    "photo_url",
    "phase"
  ]
}