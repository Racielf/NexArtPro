{
  "name": "AuthSecurityLog",
  "type": "object",
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "recovery_access_attempt",
        "recovery_access_granted",
        "recovery_access_denied",
        "recovery_restore_attempt",
        "recovery_purge_attempt",
        "recovery_session_expired",
        "suspicious_activity_detected",
        "invalid_login_attempt"
      ],
      "description": "Type of security event"
    },
    "success": {
      "type": "boolean",
      "description": "Whether the operation succeeded or failed"
    },
    "user_identifier": {
      "type": "string",
      "description": "Email or user ID of the actor"
    },
    "user_id": {
      "type": "string",
      "description": "User entity ID if available"
    },
    "origin_path": {
      "type": "string",
      "description": "App route where event originated"
    },
    "reason": {
      "type": "string",
      "description": "Detailed reason or error message"
    },
    "metadata_json": {
      "type": "object",
      "description": "Additional context (threshold, attempt count, entity_id, etc.)"
    }
  },
  "required": [
    "event_type",
    "success",
    "user_identifier"
  ]
}