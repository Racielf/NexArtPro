{
  "name": "EstimateVersionHistory",
  "type": "object",
  "properties": {
    "estimate_id": {
      "type": "string"
    },
    "estimate_number": {
      "type": "number"
    },
    "version": {
      "type": "number"
    },
    "client_name": {
      "type": "string"
    },
    "status_at_archive": {
      "type": "string"
    },
    "archived_reason": {
      "type": "string",
      "enum": [
        "changes_requested",
        "manual_override",
        "new_version"
      ],
      "default": "changes_requested"
    },
    "changes_note": {
      "type": "string"
    },
    "snapshot": {
      "type": "object",
      "description": "Full estimate data snapshot at time of archiving"
    },
    "total_at_archive": {
      "type": "number"
    },
    "archived_by": {
      "type": "string"
    }
  },
  "required": [
    "estimate_id",
    "version"
  ]
}