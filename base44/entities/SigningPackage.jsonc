{
  "name": "SigningPackage",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "viewed",
        "signed",
        "declined",
        "expired",
        "voided"
      ],
      "default": "draft"
    },
    "document_type": {
      "type": "string"
    },
    "document_id": {
      "type": "string"
    },
    "document_number": {
      "type": "string"
    },
    "document_title": {
      "type": "string"
    },
    "package_number": {
      "type": "string"
    },
    "signer_name": {
      "type": "string"
    },
    "signer_email": {
      "type": "string"
    },
    "signer_phone": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "company_id": {
      "type": "string",
      "default": "rc-art"
    },
    "signing_mode": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "token": {
      "type": "string"
    },
    "token_hash": {
      "type": "string"
    },
    "token_last_four": {
      "type": "string"
    },
    "token_created_at": {
      "type": "string"
    },
    "token_revoked_at": {
      "type": "string"
    },
    "expires_at": {
      "type": "string"
    },
    "sent_at": {
      "type": "string"
    },
    "viewed_at": {
      "type": "string"
    },
    "signed_at": {
      "type": "string"
    },
    "voided_at": {
      "type": "string"
    },
    "expired_at": {
      "type": "string"
    },
    "source_pdf_url": {
      "type": "string"
    },
    "source_pdf_name": {
      "type": "string"
    },
    "source_pdf_hash": {
      "type": "string"
    },
    "final_pdf_url": {
      "type": "string"
    },
    "final_pdf_hash": {
      "type": "string"
    },
    "hash_algorithm": {
      "type": "string",
      "default": "SHA-256"
    },
    "page_count": {
      "type": "number",
      "default": 0
    },
    "field_config": {
      "type": "object"
    },
    "document_fields": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "signature_brand_logo_url": {
      "type": "string"
    },
    "signing_package_id": {
      "type": "string"
    },
    "audit_summary": {
      "type": "object"
    },
    "otp_required": {
      "type": "boolean",
      "default": false
    },
    "otp_verified": {
      "type": "boolean",
      "default": false
    },
    "otp_locked_until": {
      "type": "string"
    },
    "otp_masked_destination": {
      "type": "string"
    },
    "otp_delivery_channel": {
      "type": "string"
    },
    "otp_expires_at": {
      "type": "string"
    },
    "active_participant_id": {
      "type": "string"
    },
    "participant_id": {
      "type": "string"
    },
    "certificate_id": {
      "type": "string"
    },
    "company_logo_url": {
      "type": "string"
    }
  },
  "required": []
}