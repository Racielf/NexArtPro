{
  "name": "SigningPackage",
  "type": "object",
  "properties": {
    "package_number": { "type": "number" },
    "document_type": {
      "type": "string",
      "enum": ["estimate", "proposal", "contract", "change_order", "invoice", "work_order", "other"],
      "default": "estimate"
    },
    "document_id": { "type": "string" },
    "document_number": { "type": "string" },
    "document_title": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["draft", "sent", "viewed", "signed", "declined", "expired", "voided"],
      "default": "draft"
    },
    "signing_mode": {
      "type": "string",
      "enum": ["internal", "external_provider"],
      "default": "internal"
    },
    "provider": {
      "type": "string",
      "enum": ["nexartsign", "docusign", "dropbox_sign", "pandadoc", "adobe_sign", "signnow", "other"],
      "default": "nexartsign"
    },
    "signer_name": { "type": "string" },
    "signer_email": { "type": "string" },
    "signer_phone": { "type": "string" },
    "client_id": { "type": "string" },
    "client_name": { "type": "string" },
    "token": { "type": "string" },
    "token_created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "sent_at": { "type": "string", "format": "date-time" },
    "viewed_at": { "type": "string", "format": "date-time" },
    "signed_at": { "type": "string", "format": "date-time" },
    "declined_at": { "type": "string", "format": "date-time" },
    "declined_reason": { "type": "string" },
    "source_pdf_url": { "type": "string" },
    "source_pdf_name": { "type": "string" },
    "source_pdf_hash": { "type": "string" },
    "final_pdf_url": { "type": "string" },
    "final_pdf_name": { "type": "string" },
    "final_pdf_hash": { "type": "string" },
    "hash_algorithm": { "type": "string", "default": "SHA-256" },
    "certificate_id": { "type": "string" },
    "certificate_url": { "type": "string" },
    "audit_summary": { "type": "object" },
    "external_request_id": { "type": "string" },
    "external_status": { "type": "string" },
    "external_payload": { "type": "object" },
    "created_by": { "type": "string" },
    "company_id": { "type": "string", "default": "rc-art" }
  },
  "required": ["document_type", "document_id", "signer_email"]
}
