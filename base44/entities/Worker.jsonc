{
  "name": "Worker",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "worker_type": {
      "type": "string",
      "enum": [
        "employee",
        "subcontractor",
        "agent"
      ],
      "default": "employee"
    },
    "trade": {
      "type": "string",
      "enum": [
        "electrician",
        "plumber",
        "carpenter",
        "painter",
        "hvac",
        "general",
        "supervisor",
        "other"
      ],
      "default": "general"
    },
    "role": {
      "type": "string",
      "enum": [
        "technician",
        "lead",
        "supervisor",
        "subcontractor"
      ],
      "default": "technician"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "emergency_contact": {
      "type": "string"
    },
    "emergency_phone": {
      "type": "string"
    },
    "hire_date": {
      "type": "string",
      "format": "date"
    },
    "license_number": {
      "type": "string"
    },
    "license_expiry": {
      "type": "string",
      "format": "date"
    },
    "insurance_expiry": {
      "type": "string",
      "format": "date"
    },
    "hourly_rate": {
      "type": "number"
    },
    "avatar_url": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "full_name"
  ]
}