{
  "name": "WorkOrderTimeEntry",
  "type": "object",
  "properties": {
    "work_order_id": {
      "type": "string",
      "description": "Reference to WorkOrder"
    },
    "worker_id": {
      "type": "string",
      "description": "Reference to Worker entity"
    },
    "worker_name": {
      "type": "string",
      "description": "Worker name snapshot at entry time"
    },
    "work_date": {
      "type": "string",
      "format": "date",
      "description": "Date of the work session"
    },
    "start_time": {
      "type": "string",
      "description": "Session start time (HH:MM)"
    },
    "end_time": {
      "type": "string",
      "description": "Session end time (HH:MM)"
    },
    "duration_hours": {
      "type": "number",
      "description": "Precomputed hours for this session (optional \u2014 derived if not set)"
    },
    "notes": {
      "type": "string"
    },
    "company_id": {
      "type": "string",
      "default": "rc-art"
    }
  },
  "required": [
    "work_order_id",
    "worker_id",
    "start_time",
    "end_time"
  ]
}