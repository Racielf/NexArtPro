{
  "name": "TimeTrackingLog",
  "type": "object",
  "properties": {
    "appointment_id": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "worker_id": {
      "type": "string"
    },
    "worker_name": {
      "type": "string"
    },
    "tracking_type": {
      "type": "string",
      "enum": [
        "travel",
        "on_site",
        "admin",
        "other"
      ],
      "default": "travel"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "start_location": {
      "type": "string"
    },
    "end_location": {
      "type": "string"
    },
    "start_lat": {
      "type": "number"
    },
    "start_lng": {
      "type": "number"
    },
    "end_lat": {
      "type": "number"
    },
    "end_lng": {
      "type": "number"
    },
    "miles_traveled": {
      "type": "number",
      "default": 0
    },
    "duration_minutes": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed"
      ],
      "default": "active"
    }
  },
  "required": [
    "tracking_type",
    "start_time"
  ]
}