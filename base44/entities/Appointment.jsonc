{
  "name": "Appointment",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "client_phone": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "client_address": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "service_type": {
      "type": "string"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date"
    },
    "scheduled_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "internal_notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "confirmed",
        "scheduled",
        "on_the_way",
        "in_progress",
        "completed",
        "cancelled",
        "no_show",
        "follow_up_needed"
      ],
      "default": "new"
    },
    "assigned_to": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "notify_customer": {
      "type": "boolean",
      "default": true
    },
    "reminder_set": {
      "type": "boolean",
      "default": false
    },
    "omw_start_lat": {
      "type": "number"
    },
    "omw_start_lng": {
      "type": "number"
    },
    "omw_end_lat": {
      "type": "number"
    },
    "omw_end_lng": {
      "type": "number"
    },
    "miles_traveled": {
      "type": "number"
    },
    "omw_start_time": {
      "type": "string"
    },
    "completed_time": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "estimate_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    }
  },
  "required": [
    "client_name",
    "scheduled_date"
  ]
}