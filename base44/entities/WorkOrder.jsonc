{
  "name": "WorkOrder",
  "type": "object",
  "properties": {
    "work_order_number": {
      "type": "number"
    },
    "estimate_id": {
      "type": "string"
    },
    "source_proposal_id": {
      "type": "string",
      "description": "ID of the Proposal this work order was converted from"
    },
    "source_proposal_number": {
      "type": "number",
      "description": "Proposal number at conversion time (snapshot)"
    },
    "source_close_outcome": {
      "type": "string",
      "description": "Deal close outcome from source Proposal (won / lost / no_response / withdrawn)"
    },
    "source_selected_pricing_option_id": {
      "type": "string",
      "description": "ID of the pricing option the client selected on the source Proposal"
    },
    "source_selected_pricing_option_title": {
      "type": "string",
      "description": "Title of the winning pricing option at conversion time (snapshot)"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "client_address": {
      "type": "string"
    },
    "client_phone": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "assigned",
        "scheduled",
        "on_the_way",
        "in_progress",
        "completed",
        "cancelled",
        "invoiced"
      ],
      "default": "draft"
    },
    "assigned_worker_id": {
      "type": "string"
    },
    "assigned_worker_name": {
      "type": "string"
    },
    "assigned_worker_phone": {
      "type": "string"
    },
    "assigned_by": {
      "type": "string"
    },
    "assigned_at": {
      "type": "string"
    },
    "previous_worker_id": {
      "type": "string"
    },
    "previous_worker_name": {
      "type": "string"
    },
    "reassigned_at": {
      "type": "string"
    },
    "reassigned_by": {
      "type": "string"
    },
    "performed_by_worker_id": {
      "type": "string"
    },
    "performed_by_worker_name": {
      "type": "string"
    },
    "performed_by_corrected_at": {
      "type": "string"
    },
    "performed_by_corrected_by": {
      "type": "string"
    },
    "completed_by_user": {
      "type": "string"
    },
    "completed_by_user_id": {
      "type": "string"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date"
    },
    "scheduled_time": {
      "type": "string"
    },
    "arrival_time": {
      "type": "string",
      "description": "Time worker arrived on site (HH:MM)"
    },
    "departure_time": {
      "type": "string",
      "description": "Time worker departed site (HH:MM)"
    },
    "groups": {
      "type": "array",
      "description": "Inherited from estimate groups",
      "items": {
        "type": "object"
      }
    },
    "line_items": {
      "type": "array",
      "description": "Legacy line items",
      "items": {
        "type": "object"
      }
    },
    "subtotal": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "internal_notes": {
      "type": "string"
    },
    "admin_correction_notes": {
      "type": "string"
    },
    "completed_at": {
      "type": "string"
    },
    "started_at": {
      "type": "string"
    },
    "work_summary": {
      "type": "string",
      "description": "Summary of work performed by the worker"
    },
    "issues_found": {
      "type": "string",
      "description": "Problems or issues found during execution"
    },
    "tasks": {
      "type": "array",
      "description": "Structured task breakdown for job execution tracking",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "in_progress",
              "completed"
            ],
            "default": "pending"
          },
          "assigned_to": {
            "type": "string"
          },
          "order": {
            "type": "number"
          },
          "started_at": {
            "type": "string"
          },
          "completed_at": {
            "type": "string"
          }
        }
      }
    },
    "task_statuses": {
      "type": "object",
      "description": "Legacy map of item id \u2192 { status: pending|done, completed_at, completed_by_worker_id } (for backward compatibility)"
    },
    "company_id": {
      "type": "string",
      "description": "Company identifier for multi-tenant support",
      "default": "rc-art"
    }
  },
  "required": [
    "client_name",
    "title"
  ]
}