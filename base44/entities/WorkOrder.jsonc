{
  "name": "WorkOrder",
  "type": "object",
  "properties": {
    "work_order_number": {
      "type": "number"
    },
    "estimate_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "client_address": {
      "type": "string"
    },
    "client_phone": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "assigned",
        "scheduled",
        "on_the_way",
        "in_progress",
        "completed",
        "cancelled",
        "invoiced"
      ],
      "default": "draft"
    },
    "assigned_worker_id": {
      "type": "string"
    },
    "assigned_worker_name": {
      "type": "string"
    },
    "assigned_worker_phone": {
      "type": "string"
    },
    "assigned_by": {
      "type": "string"
    },
    "assigned_at": {
      "type": "string"
    },
    "previous_worker_id": {
      "type": "string"
    },
    "previous_worker_name": {
      "type": "string"
    },
    "reassigned_at": {
      "type": "string"
    },
    "reassigned_by": {
      "type": "string"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date"
    },
    "scheduled_time": {
      "type": "string"
    },
    "groups": {
      "type": "array",
      "description": "Inherited from estimate groups",
      "items": {
        "type": "object"
      }
    },
    "line_items": {
      "type": "array",
      "description": "Legacy line items",
      "items": {
        "type": "object"
      }
    },
    "subtotal": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "internal_notes": {
      "type": "string"
    },
    "completed_at": {
      "type": "string"
    },
    "started_at": {
      "type": "string"
    }
  },
  "required": [
    "client_name",
    "title"
  ]
}