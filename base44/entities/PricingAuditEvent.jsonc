{
  "name": "PricingAuditEvent",
  "type": "object",
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "field_change",
        "loss_override",
        "zero_profit_confirmation",
        "send_after_override"
      ],
      "description": "Audit event classification"
    },
    "document_id": {
      "type": "string",
      "description": "ID of the estimate or proposal"
    },
    "document_kind": {
      "type": "string",
      "enum": [
        "estimate",
        "proposal",
        "bid"
      ],
      "description": "Type of document"
    },
    "user_email": {
      "type": "string"
    },
    "user_role": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "description": "Event-specific data: field_name, old_value, new_value, reason, pricing snapshot, etc."
    }
  },
  "required": [
    "document_id",
    "event_type"
  ]
}