{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "invoice_number": {
      "type": "number"
    },
    "work_order_id": {
      "type": "string"
    },
    "estimate_id": {
      "type": "string"
    },
    "estimate_version": {
      "type": "number",
      "description": "Estimate version at invoice creation time (traceability snapshot)"
    },
    "source_proposal_id": {
      "type": "string"
    },
    "source_proposal_number": {
      "type": "number"
    },
    "source_close_outcome": {
      "type": "string"
    },
    "source_selected_pricing_option_id": {
      "type": "string"
    },
    "source_selected_pricing_option_title": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "client_address": {
      "type": "string"
    },
    "client_phone": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "paid",
        "overdue",
        "cancelled"
      ],
      "default": "draft"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "subtotal": {
      "type": "number"
    },
    "discount_type": {
      "type": "string",
      "enum": [
        "percent",
        "fixed"
      ],
      "default": "percent"
    },
    "discount_value": {
      "type": "number",
      "default": 0
    },
    "discount_amount": {
      "type": "number",
      "default": 0
    },
    "tax_rate": {
      "type": "number",
      "default": 0
    },
    "tax_amount": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "amount_paid": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    },
    "internal_notes": {
      "type": "string"
    },
    "payment_terms": {
      "type": "string"
    },
    "client_response_status": {
      "type": "string",
      "enum": [
        "will_pay_soon",
        "has_question",
        "needs_time",
        "no_response"
      ],
      "default": "no_response",
      "description": "Client payment intent from portal"
    },
    "client_response_note": {
      "type": "string"
    },
    "client_response_at": {
      "type": "string",
      "format": "date-time"
    },
    "promised_payment_date": {
      "type": "string",
      "format": "date"
    },
    "promised_payment_note": {
      "type": "string"
    },
    "billing_issue_status": {
      "type": "string",
      "enum": [
        "open",
        "resolved"
      ],
      "description": "Set to 'open' when client raises a billing question; 'resolved' when addressed internally"
    },
    "billing_issue_note": {
      "type": "string",
      "description": "Client's original question or note about the billing issue"
    },
    "billing_issue_opened_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the billing issue was raised"
    },
    "billing_issue_resolved_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the billing issue was marked resolved internally"
    },
    "billing_issue_owner": {
      "type": "string",
      "description": "Internal team member assigned to resolve this billing issue"
    },
    "billing_issue_resolution_note": {
      "type": "string",
      "description": "Internal note explaining how the billing issue was resolved"
    },
    "last_contacted_at": {
      "type": "string",
      "format": "date-time"
    },
    "sent_at": {
      "type": "string"
    },
    "paid_at": {
      "type": "string"
    },
    "company_id": {
      "type": "string",
      "default": "rc-art"
    }
  },
  "required": [
    "client_name"
  ]
}