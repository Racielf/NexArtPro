{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "invoice_number": {
      "type": "number"
    },
    "work_order_id": {
      "type": "string"
    },
    "estimate_id": {
      "type": "string"
    },
    "estimate_version": {
      "type": "number",
      "description": "Estimate version at invoice creation time (traceability snapshot)"
    },
    "source_proposal_id": {
      "type": "string"
    },
    "source_proposal_number": {
      "type": "number"
    },
    "source_close_outcome": {
      "type": "string"
    },
    "source_selected_pricing_option_id": {
      "type": "string"
    },
    "source_selected_pricing_option_title": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "client_address": {
      "type": "string"
    },
    "client_phone": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "paid",
        "overdue",
        "cancelled"
      ],
      "default": "draft"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "subtotal": {
      "type": "number"
    },
    "discount_type": {
      "type": "string",
      "enum": [
        "percent",
        "fixed"
      ],
      "default": "percent"
    },
    "discount_value": {
      "type": "number",
      "default": 0
    },
    "discount_amount": {
      "type": "number",
      "default": 0
    },
    "tax_rate": {
      "type": "number",
      "default": 0
    },
    "tax_amount": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "payments": {
      "type": "array",
      "description": "Single source of truth for money received on this invoice.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "method": {
            "type": "string",
            "enum": [
              "cash",
              "card",
              "check",
              "transfer",
              "other"
            ]
          },
          "payment_date": {
            "type": "string",
            "format": "date-time"
          },
          "note": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "recorded_by": {
            "type": "string"
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "amount_paid": {
      "type": "number",
      "default": 0,
      "description": "Derived from payments[].amount."
    },
    "balance_due": {
      "type": "number",
      "default": 0,
      "description": "Derived from total - amount_paid."
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "partial",
        "paid"
      ],
      "default": "unpaid",
      "description": "Derived from payments[] and balance_due."
    },
    "notes": {
      "type": "string"
    },
    "internal_notes": {
      "type": "string"
    },
    "payment_terms": {
      "type": "string"
    },
    "client_response_status": {
      "type": "string",
      "enum": [
        "will_pay_soon",
        "has_question",
        "needs_time",
        "no_response"
      ],
      "default": "no_response",
      "description": "Client payment intent from portal"
    },
    "client_response_note": {
      "type": "string"
    },
    "client_response_at": {
      "type": "string",
      "format": "date-time"
    },
    "promised_payment_date": {
      "type": "string",
      "format": "date"
    },
    "promised_payment_note": {
      "type": "string"
    },
    "billing_issue_status": {
      "type": "string",
      "enum": [
        "open",
        "resolved"
      ],
      "description": "Set to 'open' when client raises a billing question; 'resolved' when addressed internally"
    },
    "billing_issue_note": {
      "type": "string",
      "description": "Client's original question or note about the billing issue"
    },
    "billing_issue_opened_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the billing issue was raised"
    },
    "billing_issue_resolved_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the billing issue was marked resolved internally"
    },
    "billing_issue_owner": {
      "type": "string",
      "description": "Internal team member assigned to resolve this billing issue"
    },
    "billing_issue_resolution_note": {
      "type": "string",
      "description": "Internal note explaining how the billing issue was resolved"
    },
    "sla_last_reviewed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when SLA status was last reviewed"
    },
    "sla_last_reviewed_by": {
      "type": "string",
      "description": "Email or ID of person who last reviewed SLA status"
    },
    "sla_resolution_note": {
      "type": "string",
      "description": "Internal note about SLA breach resolution actions"
    },
    "sla_resolved_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of breach type strings that have been resolved (e.g. ['missed_followup', 'broken_promise'])"
    },
    "sla_resolved_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when all active SLA breaches were resolved"
    },
    "collection_timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique event ID (uuid or timestamp-based)"
          },
          "type": {
            "type": "string",
            "enum": [
              "follow_up_sent",
              "client_contacted",
              "promise_recorded",
              "promise_broken",
              "billing_issue_opened",
              "billing_issue_assigned",
              "billing_issue_resolved",
              "sla_reviewed",
              "sla_breach_resolved",
              "payment_recorded",
              "payment_removed",
              "internal_note"
            ],
            "description": "Type of collection action"
          },
          "actor": {
            "type": "string",
            "description": "Email or ID of person who performed action"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp of action"
          },
          "note": {
            "type": "string",
            "description": "Optional note about the action"
          },
          "meta": {
            "type": "object",
            "description": "Optional metadata (e.g., amount for payment, breach_type for sla_breach_resolved)"
          }
        },
        "required": [
          "id",
          "type",
          "actor",
          "created_at"
        ]
      },
      "description": "Chronological log of collection actions and events"
    },
    "last_contacted_at": {
      "type": "string",
      "format": "date-time"
    },
    "sent_at": {
      "type": "string"
    },
    "paid_at": {
      "type": "string"
    },
    "company_id": {
      "type": "string",
      "default": "rc-art"
    }
  },
  "required": [
    "client_name"
  ]
}
