{
  "name": "RecoveryVault",
  "type": "object",
  "properties": {
    "entity_type": {
      "type": "string",
      "description": "Entity class name (e.g. Customer, Invoice, WorkOrder)"
    },
    "entity_id": {
      "type": "string",
      "description": "Original record ID"
    },
    "module": {
      "type": "string",
      "description": "Module key from recovery registry (e.g. customers, invoices)"
    },
    "record_label": {
      "type": "string",
      "description": "Human-readable label for the record at delete time"
    },
    "reference_number": {
      "type": "string",
      "description": "Reference number if available (e.g. INV#42, WO#7)"
    },
    "snapshot_json": {
      "type": "object",
      "description": "Full record JSON snapshot at delete time"
    },
    "search_text": {
      "type": "string",
      "description": "Denormalized search index: label + number + email + reason combined"
    },
    "deleted_by": {
      "type": "string",
      "description": "Actor who deleted the record"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of soft delete"
    },
    "delete_reason": {
      "type": "string",
      "description": "Reason provided at delete time"
    },
    "origin_path": {
      "type": "string",
      "description": "App route where the record originated (e.g. /invoices)"
    },
    "is_restored": {
      "type": "boolean",
      "default": false,
      "description": "True if the record has been restored"
    },
    "restored_at": {
      "type": "string",
      "format": "date-time"
    },
    "restored_by": {
      "type": "string"
    },
    "is_purged": {
      "type": "boolean",
      "default": false,
      "description": "True if the original record was hard deleted. Vault entry is kept as historical evidence."
    },
    "purged_at": {
      "type": "string",
      "format": "date-time"
    },
    "purged_by": {
      "type": "string"
    },
    "company_id": {
      "type": "string",
      "default": "rc-art"
    }
  },
  "required": [
    "entity_type",
    "entity_id",
    "deleted_by",
    "deleted_at"
  ]
}