{
  "name": "Proposal",
  "type": "object",
  "properties": {
    "proposal_number": {
      "type": "number"
    },
    "source_estimate_id": {
      "type": "string",
      "description": "Reference to source Estimate if created from one"
    },
    "creation_mode": {
      "type": "string",
      "enum": [
        "new_proposal",
        "from_estimate"
      ],
      "default": "new_proposal"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "client_phone": {
      "type": "string"
    },
    "client_address": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review_needed",
        "sent",
        "approved",
        "accepted",
        "rejected",
        "converted_to_invoice",
        "converted_to_work_order",
        "pending_adjustment"
      ],
      "default": "draft"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "subtotal": {
      "type": "number",
      "default": 0
    },
    "tax_rate": {
      "type": "number",
      "default": 0
    },
    "tax_amount": {
      "type": "number",
      "default": 0
    },
    "discount_value": {
      "type": "number",
      "default": 0
    },
    "total_amount": {
      "type": "number",
      "default": 0
    },
    "total_cost": {
      "type": "number",
      "default": 0,
      "description": "Sum of all unit_cost * quantity (internal)"
    },
    "gross_margin": {
      "type": "number",
      "default": 0,
      "description": "Total - Total Cost (internal)"
    },
    "gross_margin_pct": {
      "type": "number",
      "default": 0,
      "description": "Gross margin percentage (internal)"
    },
    "payment_terms": {
      "type": "string"
    },
    "legal_terms": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "internal_notes": {
      "type": "string"
    },
    "expiration_date": {
      "type": "string",
      "format": "date"
    },
    "template_name": {
      "type": "string",
      "default": "professional"
    },
    "sent_at": {
      "type": "string"
    },
    "viewed_at": {
      "type": "string"
    },
    "view_count": {
      "type": "number",
      "default": 0
    },
    "approved_at": {
      "type": "string"
    },
    "accepted_at": {
      "type": "string"
    },
    "accepted_ip": {
      "type": "string"
    },
    "accepted_by_name": {
      "type": "string"
    },
    "rejected_at": {
      "type": "string"
    },
    "rejected_reason": {
      "type": "string"
    },
    "invoice_id": {
      "type": "string"
    },
    "invoice_number": {
      "type": "string"
    },
    "work_order_id": {
      "type": "string"
    },
    "work_order_number": {
      "type": "number"
    },
    "adjustment_estimate_id": {
      "type": "string",
      "description": "Estimate created for negotiation/adjustment"
    },
    "adjustment_estimate_number": {
      "type": "number"
    },
    "adjustment_reason": {
      "type": "string",
      "description": "Reason/change log when adjustment estimate was requested"
    },
    "company_id": {
      "type": "string",
      "default": "rc-art"
    }
  },
  "required": [
    "client_name",
    "status"
  ]
}