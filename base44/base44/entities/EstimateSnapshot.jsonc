{
  "name": "EstimateSnapshot",
  "type": "object",
  "properties": {
    "estimate_id": {
      "type": "string",
      "description": "Reference to original Estimate"
    },
    "estimate_number": {
      "type": "number"
    },
    "version": {
      "type": "number",
      "description": "Version of estimate at send time"
    },
    "sent_at": {
      "type": "string",
      "description": "Timestamp when sent"
    },
    "sent_by": {
      "type": "string",
      "description": "Email of user who sent"
    },
    "client_name": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "BID",
        "PROPOSAL",
        "ESTIMATE"
      ],
      "default": "ESTIMATE"
    },
    "document_language": {
      "type": "string",
      "enum": [
        "en",
        "es",
        "bilingual"
      ],
      "default": "en"
    },
    "title": {
      "type": "string"
    },
    "estimate_data": {
      "type": "object",
      "description": "Immutable snapshot of full estimate at send time"
    },
    "document_config": {
      "type": "object",
      "description": "Template and rendering options used at send time"
    },
    "total": {
      "type": "number"
    },
    "pdf_file_url": {
      "type": "string",
      "description": "URL or path to stored PDF"
    },
    "pdf_file_name": {
      "type": "string"
    },
    "pdf_mime_type": {
      "type": "string",
      "default": "application/pdf"
    },
    "client_attachments": {
      "type": "array",
      "description": "Snapshot of send_to_client attachments",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "estimate_id",
    "sent_at"
  ]
}