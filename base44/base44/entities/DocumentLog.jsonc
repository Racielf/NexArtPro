{
  "name": "DocumentLog",
  "type": "object",
  "properties": {
    "estimate_id": {
      "type": "string"
    },
    "estimate_number": {
      "type": "number"
    },
    "client_name": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "printed",
        "downloaded",
        "sent_email",
        "sent_link",
        "viewed"
      ],
      "default": "sent_email"
    },
    "recipient_email": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "secure_link": {
      "type": "string"
    },
    "total_amount": {
      "type": "number"
    },
    "status_at_send": {
      "type": "string"
    }
  },
  "required": [
    "estimate_id",
    "action"
  ]
}