{
  "name": "WorkOrderDailyReport",
  "type": "object",
  "properties": {
    "work_order_id": {
      "type": "string"
    },
    "work_order_number": {
      "type": "number"
    },
    "worker_id": {
      "type": "string"
    },
    "worker_name": {
      "type": "string"
    },
    "work_date": {
      "type": "string",
      "format": "date"
    },
    "arrival_time": {
      "type": "string"
    },
    "departure_time": {
      "type": "string"
    },
    "labor_hours": {
      "type": "number",
      "default": 0
    },
    "travel_hours": {
      "type": "number",
      "default": 0
    },
    "summary_of_work": {
      "type": "string"
    },
    "tasks_completed": {
      "type": "string"
    },
    "tasks_pending": {
      "type": "string"
    },
    "issues_found": {
      "type": "string"
    },
    "next_steps": {
      "type": "string"
    }
  },
  "required": [
    "work_order_id"
  ]
}