{
  "name": "WorkOrderReceipt",
  "type": "object",
  "properties": {
    "work_order_id": {
      "type": "string"
    },
    "expense_id": {
      "type": "string"
    },
    "uploaded_by": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "vendor": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "receipt_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "work_order_id",
    "file_url"
  ]
}