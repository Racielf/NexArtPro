{
  "name": "WorkOrderExpense",
  "type": "object",
  "properties": {
    "work_order_id": {
      "type": "string"
    },
    "work_order_number": {
      "type": "number"
    },
    "worker_id": {
      "type": "string"
    },
    "worker_name": {
      "type": "string"
    },
    "expense_type": {
      "type": "string",
      "enum": [
        "materials",
        "tools",
        "fuel",
        "food",
        "cash_advance",
        "other"
      ],
      "default": "materials"
    },
    "description": {
      "type": "string"
    },
    "vendor": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "card",
        "check",
        "company_card",
        "advance"
      ],
      "default": "cash"
    },
    "reimbursable": {
      "type": "boolean",
      "default": false
    },
    "cash_advance_amount": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "work_order_id",
    "expense_type",
    "amount"
  ]
}