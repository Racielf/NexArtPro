{
  "name": "SigningParticipant",
  "type": "object",
  "properties": {
    "signing_package_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "default": "signer"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "signed",
        "declined",
        "skipped",
        "voided"
      ],
      "default": "pending"
    },
    "signing_order": {
      "type": "number",
      "default": 1
    },
    "token": {
      "type": "string"
    },
    "token_hash": {
      "type": "string"
    },
    "token_last_four": {
      "type": "string"
    },
    "token_created_at": {
      "type": "string"
    },
    "token_revoked_at": {
      "type": "string"
    },
    "sent_at": {
      "type": "string"
    },
    "signed_at": {
      "type": "string"
    },
    "reminder_last_sent_at": {
      "type": "string"
    },
    "reminder_count": {
      "type": "number",
      "default": 0
    },
    "company_id": {
      "type": "string",
      "default": "rc-art"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "signing_package_id",
    "email"
  ]
}